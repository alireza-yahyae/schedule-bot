{
  "name": "schedule-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram schedule, reminders and habits bot (Mini App) on Cloudflare Workers: D1 + one private Durable Object database per person",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "gen:schema": "node scripts/gen-tenant-schema.mjs",
    "deploy": "node scripts/gen-tenant-schema.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply schedule-bot-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply schedule-bot-db --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
